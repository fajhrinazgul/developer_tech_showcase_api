import os
import django # 1. Import django terlebih dahulu
from django.core.asgi import get_asgi_application

# 2. Set environment settings sebelum mengimpor Channels/App Anda
os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'developer_tech_showcase_api.settings')

# 3. Jalankan inisialisasi Django secara eksplisit
django.setup()

# 4. Ambil get_asgi_application SEBELUM mengimpor file Channels Anda
django_asgi_app = get_asgi_application()

# 5. Impor middleware dan routing di bawah django.setup()
from channels.routing import ProtocolTypeRouter, URLRouter
from channels.security.websocket import AllowedHostsOriginValidator
import notifications.routing
from notifications.middleware import JWTAuthMiddleware

# 6. Jalankan konfigurasi ProtocolTypeRouter
application = ProtocolTypeRouter({
    "http": django_asgi_app, # Gunakan instance yang di-load duluan
    "websocket": AllowedHostsOriginValidator(
        JWTAuthMiddleware(
            URLRouter(
                notifications.routing.websocket_urlpatterns
            )
        )
    )
})